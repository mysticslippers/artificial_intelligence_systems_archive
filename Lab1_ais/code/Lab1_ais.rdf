    <!-- http://ontologies/movies.owl#Actor -->

    <owl:Class rdf:about="http://ontologies/movies.owl#Actor">
        <rdfs:subClassOf rdf:resource="http://ontologies/movies.owl#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontologies/movies.owl#hasActedIn"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontologies/movies.owl#Director -->

    <owl:Class rdf:about="http://ontologies/movies.owl#Director">
        <rdfs:subClassOf rdf:resource="http://ontologies/movies.owl#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontologies/movies.owl#hasDirectedIn"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ontologies/movies.owl#GenderValue -->

